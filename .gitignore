# list of files/directories to NOT commit to the git repo

# AWS keys
aws/

# mbtiles files (too large for git — download separately or build locally)
tiles/*.mbtiles

# claude details 
.claude/
CLAUDE.md 

# python cache 
__pycache__/
*.pyc
*.pyo

# ignore the DS_Store stuff
.DS_Store

# AppleDouble shadow files (exFAT/external-drive checkouts generate these)
._*

# build artifacts
STORM.app
*.iconset/

# icon source and generator — dev only, icons committed directly
storm.png
scripts/create_icon.py

# no device-specific python env files
*.egg-info/

# ignore the data used to test the app 
*.log
veh_data/

# roadmap (is for local progress only)
roadmap.txt

# password management utility — not for repo
set_password.py

# locs/ source data — kept locally, not needed in repo
locs/merge_locs.py
locs/all_rounds052615.txt
locs/sites.info
locs/deployment_locations.json

# storm tracks: the shared MESO-VIEW set ships with STORM; users' own
# workspaces (tracks they create or edit) stay on their machine
data/storm_tracks/*
!data/storm_tracks/README.md
!data/storm_tracks/Pardun_Tracks/

# case packages users export (data/case_packages/<session date>/*.zip)
data/case_packages/

# RAP/RUC analyses downloaded for base states (core/base_state.py)
data/rap_cache/
data/terrain_cache/
